# Data Files (CSV datasets)
# Ignore all CSVs except output.csv in repo root (required for submission)
*.csv
!output.csv

# Dataset Folders (organizer-provided data, not part of solution)
dataset/
data/

# Logs
# Keep log.txt for chat transcript submission, ignore other logs
*.log
